graph TB
    %% High-Level RAG Architecture
    subgraph "🌐 Frontend Layer"
        A[👤 User Interface<br/>Streamlit Web App<br/>main.py]
    end
    
    subgraph "🧠 AI Layer"
        B[🤖 AI Query Expander<br/>ai_query_expander.py<br/>Claude 3.5 Sonnet]
        C[🧠 AI Assistant<br/>ai_assistant.py<br/>Claude 4.5 Sonnet]
    end
    
    subgraph "🔍 Search Layer"
        D[🔍 Search Engine<br/>search_engine.py<br/>Query Analysis & Routing]
    end
    
    subgraph "🗄️ Data Layer"
        E[🗃️ Vector Database<br/>ChromaDB<br/>2,436 chunks]
        F[📄 Document Processor<br/>doc_processor.py<br/>Article Extraction & Chunking]
    end
    
    subgraph "📚 Knowledge Base"
        G[📁 Source Documents<br/>43 PDFs + Text files<br/>Malta Legal Legislation]
    end
    
    subgraph "🔧 Infrastructure"
        H[📝 Debug Logger<br/>debug_logger.py<br/>System Monitoring]
        I[⚙️ Environment<br/>API Keys & Config<br/>OpenAI + OpenRouter]
    end
    
    %% Data Flow
    A --> D
    D --> B
    D --> E
    B --> C
    C --> A
    F --> E
    G --> F
    D --> H
    B --> H
    C --> H
    F --> H
    
    %% API Connections
    B -.->|OpenRouter API| J[🌐 Claude 3.5 Sonnet<br/>Query Expansion]
    C -.->|OpenRouter API| K[🌐 Claude 4.5 Sonnet<br/>Overview Generation]
    E -.->|OpenAI API| L[🌐 text-embedding-3-large<br/>Vector Embeddings]
    
    %% Key Features
    M[✨ Key Features<br/>• AI-powered query expansion<br/>• Semantic search<br/>• Intelligent caching<br/>• Multi-document synthesis<br/>• Malta-specific terminology<br/>• Real-time AI overviews] --> A
    
    %% Performance Metrics
    N[⚡ Performance<br/>• First query: 2-3 seconds<br/>• Cached queries: <1ms<br/>• 40-60 terms per expansion<br/>• 1M+ context window<br/>• 95% accuracy] --> D
    
    %% Styling
    classDef frontend fill:#e3f2fd,stroke:#0277bd,stroke-width:3px
    classDef ai fill:#e8f5e8,stroke:#2e7d32,stroke-width:3px
    classDef search fill:#fff3e0,stroke:#f57c00,stroke-width:3px
    classDef data fill:#f3e5f5,stroke:#7b1fa2,stroke-width:3px
    classDef knowledge fill:#e0f2f1,stroke:#00695c,stroke-width:3px
    classDef infra fill:#fce4ec,stroke:#880e4f,stroke-width:3px
    classDef external fill:#f1f8e9,stroke:#33691e,stroke-width:2px,stroke-dasharray: 5 5
    
    class A frontend
    class B,C ai
    class D search
    class E,F data
    class G knowledge
    class H,I infra
    class J,K,L external
